# V2 环境配置
# 复制为 .env 后修改

# MySQL (V2 独立库)
MYSQL_ROOT_PASSWORD=<your-mysql-root-password>
MYSQL_DATABASE=food_agent_v2_h07
MYSQL_USER=food_agent_v2
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3309

# Qdrant (V2 独立 Collection)
QDRANT_HOST=127.0.0.1
QDRANT_REST_PORT=6339
QDRANT_GRPC_PORT=6340
QDRANT_COLLECTION=recipe_retrieval_v2_h07

# Redis (V2 独立前缀)
REDIS_HOST=127.0.0.1
REDIS_PORT=6382
REDIS_KEY_PREFIX=v2:h07

# LLM —— DeepSeek 官方接口；按量计费，密钥从 DeepSeek 官方平台获取。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=<your-deepseek-api-key>
LLM_TIMEOUT_SECONDS=30
LLM_MODEL_REASONING=deepseek-v4-pro
LLM_MODEL_REASONING_EXTRA_BODY={"thinking":{"type":"enabled"},"reasoning_effort":"low"}
# 查询与正文关闭思考；Agent 决策保留 low 思考以兼顾响应时间。
LLM_MODEL_QUERY_EXTRA_BODY={"thinking":{"type":"disabled"}}
LLM_MODEL_ANSWER=deepseek-v4-pro
LLM_MODEL_ANSWER_EXTRA_BODY={"thinking":{"type":"disabled"}}

# API
API_HOST=127.0.0.1
API_PORT=8003
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# RAG API 运行参数
RAG_WARMUP_ON_STARTUP=true
# 顺序释放嵌入/重排客户端，保持请求生命周期简单。
MODEL_LOW_MEMORY_MODE=true

# 硅基流动 —— 嵌入与重排 API
SILICONFLOW_API_KEY=<your-siliconflow-api-key>
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
