# V2 环境配置
# 复制为 .env 后修改

# MySQL (V2 独立库)
MYSQL_ROOT_PASSWORD=foodagent_v2
MYSQL_DATABASE=food_agent_v2
MYSQL_USER=foodagent
MYSQL_PASSWORD=foodagent_v2
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Qdrant (V2 独立 Collection)
QDRANT_HOST=localhost
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=recipe_retrieval_v2

# Redis (V2 独立前缀)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY_PREFIX=v2

# LLM —— 任何 OpenAI 兼容提供商；使用 Qwen 时查询理解可单独关闭思考模式。
LLM_BASE_URL=<your-openai-compatible-base-url>
LLM_API_KEY=<your-api-key>
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MODEL_REASONING=<your-reasoning-model>
LLM_MODEL_REASONING_EXTRA_BODY=
# 仅 query_understanding 使用。Qwen 示例：关闭思考模式以获得结构化查询结果。
LLM_MODEL_QUERY_EXTRA_BODY={"enable_thinking":false}
LLM_MODEL_ANSWER=<your-answer-model>
LLM_MODEL_ANSWER_EXTRA_BODY=

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5174

# 工作流模式：fast_path=确定性快速路径（默认）；legacy=五模型主链（回滚开关）
WORKFLOW_MODE=fast_path

# 模型路径
BGE_MODEL_PATH=.model-cache/bge-m3
RERANKER_MODEL_PATH=.model-cache/bge-reranker-v2-m3
RAG_WARMUP_ON_STARTUP=true
# 16 GB CPU 竞赛机默认顺序加载两个 BGE 模型，避免同时常驻导致 OOM。
MODEL_LOW_MEMORY_MODE=true
MODEL_DEVICE=auto

# 硅基流动 —— 嵌入与重排 API（替代本地 BGE 模型加载）
SILICONFLOW_API_KEY=<your-siliconflow-api-key>
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
