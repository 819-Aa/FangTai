# V2 环境配置
# 复制为 .env 后修改

# MySQL (V2 独立库)
MYSQL_ROOT_PASSWORD=<your-mysql-root-password>
MYSQL_DATABASE=food_agent_v2_h07
MYSQL_USER=food_agent_v2
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3309

# Qdrant (V2 独立 Collection)
QDRANT_HOST=127.0.0.1
QDRANT_REST_PORT=6339
QDRANT_GRPC_PORT=6340
QDRANT_COLLECTION=recipe_retrieval_v2_h07

# Redis (V2 独立前缀)
REDIS_HOST=127.0.0.1
REDIS_PORT=6382
REDIS_KEY_PREFIX=v2:h07

# LLM —— 任何 OpenAI 兼容提供商；使用 Qwen 时查询理解可单独关闭思考模式。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=<your-api-key>
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MODEL_REASONING=qwen3.8-max
LLM_MODEL_REASONING_EXTRA_BODY=
# 仅 query_understanding 使用。Qwen 示例：关闭思考模式以获得结构化查询结果。
LLM_MODEL_QUERY_EXTRA_BODY={"enable_thinking":false}
LLM_MODEL_ANSWER=qwen3.8-max
LLM_MODEL_ANSWER_EXTRA_BODY=

# API
API_HOST=127.0.0.1
API_PORT=8003
CORS_ORIGINS=http://localhost:5174

# 工作流模式：fast_path=确定性快速路径（默认）；legacy=五模型主链（回滚开关）
WORKFLOW_MODE=fast_path

# RAG API 运行参数
RAG_WARMUP_ON_STARTUP=true
# 顺序释放嵌入/重排客户端，保持请求生命周期简单。
MODEL_LOW_MEMORY_MODE=true

# 硅基流动 —— 嵌入与重排 API
SILICONFLOW_API_KEY=<your-siliconflow-api-key>
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
