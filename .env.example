# V2 环境配置
# 复制为 .env 后修改

# MySQL (V2 独立库)
MYSQL_ROOT_PASSWORD=foodagent_v2
MYSQL_DATABASE=food_agent_v2
MYSQL_USER=foodagent
MYSQL_PASSWORD=foodagent_v2
MYSQL_HOST=localhost
MYSQL_PORT=3307

# Qdrant (V2 独立 Collection)
QDRANT_HOST=localhost
QDRANT_REST_PORT=6335
QDRANT_GRPC_PORT=6336
QDRANT_COLLECTION=recipe_retrieval_v2

# Redis (V2 独立前缀)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_KEY_PREFIX=v2

# LLM —— 阿里百炼 DashScope (或其他 OpenAI 兼容 API)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=<your-api-key>
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MODEL_REASONING=qwen3.7-max
LLM_MODEL_REASONING_EXTRA_BODY={"enable_thinking": false}
LLM_MODEL_ANSWER=qwen3.7-plus
LLM_MODEL_ANSWER_EXTRA_BODY={"enable_thinking": false}

# API
API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=http://localhost:5174

# 模型路径
BGE_MODEL_PATH=.model-cache/bge-m3
RERANKER_MODEL_PATH=.model-cache/bge-reranker-v2-m3
RAG_WARMUP_ON_STARTUP=true
# 16 GB CPU 竞赛机默认顺序加载两个 BGE 模型，避免同时常驻导致 OOM。
MODEL_LOW_MEMORY_MODE=true
MODEL_DEVICE=auto
